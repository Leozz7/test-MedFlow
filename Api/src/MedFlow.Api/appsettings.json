{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=medflow_db;Username=postgres;Password=postgres"
  },
  "Security": {
    "PasswordPepper": "MeuPepperSuperSecreto123!",
    "Argon2MemoryCostKB": "65536",
    "Argon2TimeCost": "3",
    "Argon2Lanes": "4"
  },
  "Jwt": {
    "Key": "MedFlowSuperSecretKey_1234567890_MuitoGrande",
    "Issuer": "MedFlowApi",
    "Audience": "MedFlowUsers"
  },
  "RabbitMQ": {
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "guest",
    "Password": "guest"
  },
  "Seed": {
    "AdminEmail": "admin@medflow.com",
    "AdminPassword": "AdminPassword123!"
  }
}
